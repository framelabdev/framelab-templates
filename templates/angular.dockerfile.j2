FROM {{ base_image }}

# Install Node.js as root (user already exists in base image)
USER root

# Update package lists and install Node.js and npm
RUN apt-get update && \
    apt-get install -y curl ca-certificates gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_{{ node_version }}.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create workspace directory with proper permissions
RUN mkdir -p /home/framelab/workspace && \
    chown framelab:framelab /home/framelab/workspace

# Switch back to framelab user
USER framelab

# Set working directory
WORKDIR /home/framelab/workspace

# Copy package files
COPY --chown=framelab:framelab templates/angular/package*.json ./

# Install dependencies
RUN {{ install_command }}

# Copy source code
COPY --chown=framelab:framelab templates/angular/ .

# Install additional packages if specified
{% if additional_packages %}
RUN npm install -g {{ additional_packages | join(' ') }}
{% endif %}

# Install VSCode extensions if specified
{% if vscode_extensions %}
RUN for ext in {{ vscode_extensions | join(' ') }}; do \
        /opt/openvscode-server/bin/openvscode-server --install-extension $ext; \
    done
{% endif %}

# Expose port
EXPOSE {{ port }}

# Set default command
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "{{ port }}"]