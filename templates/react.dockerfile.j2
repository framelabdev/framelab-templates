FROM {{ base_image }}

# Switch to root to install Node.js
USER root

# Install Node.js and npm
RUN curl -fsSL https://deb.nodesource.com/setup_{{ node_version }}.x | bash - && \
    apt-get install -y nodejs

# Switch back to framelab user
USER framelab

# Set working directory
WORKDIR /home/framelab/workspace

# Copy package files
COPY --chown=framelab:framelab templates/react/package*.json ./

# Install dependencies
RUN {{ install_command }}

# Copy source code
COPY --chown=framelab:framelab templates/react/ .

# Install additional packages if specified
{% if additional_packages %}
RUN npm install -g {{ additional_packages | join(' ') }}
{% endif %}

# Install VSCode extensions if specified
{% if vscode_extensions %}
RUN for ext in {{ vscode_extensions | join(' ') }}; do \
        /opt/openvscode-server/bin/openvscode-server --install-extension $ext; \
    done
{% endif %}

# Expose port
EXPOSE {{ port }}

# Set default command
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "{{ port }}"]