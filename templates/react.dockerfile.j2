FROM {{ base_image }}

# Install Node.js as root (user already exists in base image)
USER root

# Update package lists and install Node.js and npm
RUN apt-get update && \
    apt-get install -y curl ca-certificates gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_{{ node_version }}.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install additional packages globally as root
{% if additional_packages %}
RUN npm install -g {{ additional_packages | join(' ') }}
{% endif %}

# Switch back to framelab user (already exists in base image)
USER framelab

# Set working directory (base image already sets /home/framelab, we'll use workspace subdirectory)
WORKDIR /home/framelab/workspace

# Copy package files
COPY --chown=framelab:framelab templates/react/package*.json ./

# Install dependencies
RUN {{ install_command }}

# Copy source code
COPY --chown=framelab:framelab templates/react/ .

# Additional packages already installed globally as root

# Install VSCode extensions if specified
{% if vscode_extensions %}
RUN for ext in {{ vscode_extensions | join(' ') }}; do \
        /opt/openvscode-server/bin/openvscode-server --install-extension $ext; \
    done
{% endif %}

# Expose port
EXPOSE {{ port }}

# Set default command
# CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "{{ port }}"]